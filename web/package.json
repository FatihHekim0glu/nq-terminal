{
  "name": "nq-lab-terminal-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.5.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/bundleCheck.ts dist",
    "build:gallery": "vite build --mode gallery && node scripts/bundleCheck.ts dist-gallery --gallery",
    "demo": "vite --mode demo --port 5174",
    "build:demo": "vite build --mode demo && node scripts/bundleCheck.ts dist-demo --demo",
    "preview": "vite preview",
    "test": "node src/api/codegen/gen-api.mjs --check && vitest run",
    "test:watch": "vitest",
    "test:types": "tsc -b",
    "gen:api": "node src/api/codegen/gen-api.mjs",
    "check:api": "node src/api/codegen/gen-api.mjs --check",
    "e2e": "playwright test --project=chromium",
    "e2e:perf": "playwright test --project=perf --workers=1",
    "e2e:offline": "playwright test -c playwright.offline.config.ts --project=offline --project=offline-demo",
    "e2e:offline:perf": "playwright test -c playwright.offline.config.ts --project=offline-perf --workers=1",
    "e2e:offline:baseline": "playwright test -c playwright.offline.config.ts --project=offline --project=offline-demo --update-snapshots=all",
    "test:e2e-types": "tsc -p e2e/tsconfig.json && tsc -p e2e/offline/tsconfig.json && tsc -p e2e/flows/tsconfig.json && tsc -p e2e/perf/tsconfig.json && tsc -p e2e/visual/tsconfig.json"
  },
  "dependencies": {
    "@fontsource/pt-mono": "5.3.0",
    "@fontsource/source-sans-3": "5.3.0",
    "@perspective-dev/client": "5.5.1",
    "@perspective-dev/server": "5.5.1",
    "@perspective-dev/viewer": "5.5.1",
    "@perspective-dev/viewer-datagrid": "5.5.1",
    "@tanstack/react-query": "5.103.2",
    "@tanstack/react-table": "9.2.4",
    "@tanstack/react-virtual": "3.14.13",
    "cmdk": "1.1.1",
    "dockview-react": "8.3.1",
    "echarts": "6.1.0",
    "lightweight-charts": "5.2.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "uplot": "1.6.32",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "30.1.1",
    "openapi-typescript": "7.13.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
